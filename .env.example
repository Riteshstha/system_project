# Copy to .env and fill in real values. NEVER commit .env.

# --- Database (PostgreSQL) ---
# Least-privilege user: the app uses a dedicated DB user, not the superuser.
DATABASE_URL="postgresql://app_user:CHANGE_ME@db:5432/system_website"

# --- Application ---
NODE_ENV=production
DOMAIN=localhost
PORT=3000
# Secret for signing session tokens / CSRF. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=CHANGE_ME
NEXT_PUBLIC_SITE_URL=https://yourdomain.com
# Client portal app URL (separate Next.js app on port 3200)
NEXT_PUBLIC_PORTAL_URL=http://localhost:3200

# --- Transactional email (Resend) ---
RESEND_API_KEY=re_CHANGE_ME
EMAIL_FROM=noreply@yourdomain.com
# Company inbox where orders land (a Gmail address is fine here).
COMPANY_EMAIL=hello@yourdomain.com

# --- Bot Protection (Cloudflare Turnstile) ---
# Get keys from https://dash.cloudflare.com/ > Turnstile
TURNSTILE_SECRET_KEY=CHANGE_ME
NEXT_PUBLIC_TURNSTILE_SITE_KEY=CHANGE_ME

# --- Payment: eSewa (Phase 3a) ---
# Get credentials from https://developer.esewa.com.np/
# UAT (test): merchant_code=EPAYTEST, secret from UAT dashboard
# Live: your assigned merchant code and secret
ESEWA_MERCHANT_CODE=EPAYTEST
ESEWA_SECRET=CHANGE_ME
ESEWA_BASE_URL=https://uat.esewa.com.np

# --- Payment: Stripe (Phase 3b - for subscriptions) ---
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PUBLISHABLE_KEY=pk_test_...

# --- Payment: Khalti (Phase 3b - Nepal alternative) ---
# KHALTI_SECRET=...
# KHALTI_PUBLIC_KEY=...

# --- DNS (Phase 5) ---
# Single Cloudflare API token with Zone.DNS.Edit permissions only
CLOUDFLARE_API_TOKEN=CHANGE_ME
# Our company domain zone ID (for Option B subdomain fallback)
CLOUDFLARE_ZONE_ID=CHANGE_ME

# --- Container status agent (Phase 4) ---
# DOCKER_HOST=tcp://docker-socket-proxy:2375

# --- Backup / Monitoring ---
# RESTIC_REPOSITORY=s3:s3.wasabisys.com/your-bucket
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...
# RESTIC_PASSWORD=...
# UPTIME_KUMA_PUSH_URL_DB=...
# UPTIME_KUMA_PUSH_URL_VOLUMES=...