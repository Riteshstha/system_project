# Local development Dockerfile
# Usage: docker build -f Dockerfile.local -t acme-web-studio:dev .
#        docker run -p 3000:3000 --env-file .env acme-web-studio:dev

FROM node:20-alpine

WORKDIR /app

# Install dependencies first (cached layer)
COPY package*.json ./
RUN npm ci

# Copy Prisma schema and generate client
COPY prisma ./prisma/
RUN npx prisma generate

# Copy source
COPY . .

EXPOSE 3000

CMD ["npm", "run", "dev"]