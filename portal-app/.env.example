# Environment variables for portal app
NEXT_PUBLIC_SITE_URL=http://localhost:3200
NEXT_PUBLIC_MAIN_APP_URL=http://localhost:3000

# Database (shared with main app)
DATABASE_URL=postgresql://app_user:password@db:5432/system_website?schema=public

# Auth
JWT_SECRET=your-super-secret-jwt-key-change-in-production
SESSION_COOKIE_NAME=session_token
SESSION_COOKIE_MAX_AGE=604800

# Email (Resend)
RESEND_API_KEY=
EMAIL_FROM=noreply@acmewebstudio.com
COMPANY_EMAIL=info@acmewebstudio.com

# eSewa Payment
ESEWA_MERCHANT_CODE=
ESEWA_SECRET=